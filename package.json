{
  "name": "napi-router",
  "version": "1.1.0",
  "description": "Bun-compatible HTTP server powered by Rust via NAPI — works in Node.js, Bun, and Deno",
  "keywords": [
    "napi",
    "native",
    "rust",
    "http",
    "server",
    "websocket",
    "bun-compatible",
    "bun",
    "hono",
    "validator",
    "schema",
    "validation"
  ],
  "homepage": "https://github.com/nglmercer/napi-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nglmercer/napi-router.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/serve.d.ts",
      "import": "./dist/adapter/serve.js",
      "default": "./dist/adapter/serve.js"
    },
    "./adapter/serve": {
      "types": "./dist/adapter/serve.d.ts",
      "import": "./dist/adapter/serve.js",
      "default": "./dist/adapter/serve.js"
    },
    "./adapter/router": {
      "types": "./dist/adapter/router/router.d.ts",
      "import": "./dist/adapter/router/router.js",
      "default": "./dist/adapter/router/router.js"
    },
    "./adapter/router/validator": {
      "types": "./dist/adapter/router/router/validator.d.ts",
      "import": "./dist/adapter/router/router/validator.js",
      "default": "./dist/adapter/router/router/validator.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:ts": "tsc -p tsconfig.build.json",
    "clean": "napi clean && cargo clean && rm -rf dist",
    "test": "bun test",
    "dev": "node --watch examples/dev.ts",
    "bench": "bun bench/compare.ts",
    "bench:simple": "bun bench/server.ts",
    "bench:validator": "bun bench/validator.bench.ts",
    "build:multi": "bun scripts/build_multiplatform.ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write index.js index.d.ts adapter/**/*.ts examples/",
    "lint": "rustup run stable cargo clippy -- -D warnings",
    "prepublishOnly": "npm run lint && npm run test && npm run build && npm run build:ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "typescript": "^5.6.2",
    "hono": "^4.12.22"
  },
  "napi": {
    "binaryName": "napi-router",
    "targets": [
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  }
}
